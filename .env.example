# Required for Gemini 2.5 Flash chatbot and image analysis
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional: only needed if you want Google Cloud Vision enabled
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json

# Optional: currently reserved for S3 storage if you wire uploads to S3 later
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_s3_bucket_name

# Local frontend URL allowed to call the backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public backend URL used when returning local upload URLs.
# Locally this should stay localhost. On Render, set it to your Render backend URL.
BACKEND_PUBLIC_URL=http://localhost:8000

# Set to false if live Sephora/StyleKorean lookup is slow or unavailable
ENABLE_LIVE_PRODUCT_SEARCH=true

# Optional S3 settings
S3_UPLOAD_PREFIX=uploads
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600
